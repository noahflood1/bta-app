rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // This rule allows anyone with your Firestore database reference to view, edit,
    // and delete all data in your Firestore database. It is useful for getting
    // started, but it is configured to expire after 30 days because it
    // leaves your app open to attackers. At that time, all client
    // requests to your Firestore database will be denied.
    //
    // Make sure to write security rules for your app before that time, or else
    // all client requests to your Firestore database will be denied until you Update
    // your rules
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2025, 5, 30);
    }
  }
}

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow user to read/write their root profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Allow access to user's workout history
      match /workouts/{workoutId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        // Access to segments of a workout
        match /segments/{segmentId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }

        // Access to workout-specific stats
        match /shooting_stats/{doc} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
        match /training_stats/{doc} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }

      // Global stats
      match /shooting_stats/{doc} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /training_stats/{doc} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
